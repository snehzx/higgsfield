// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User{
  id String @id @default(uuid())
  username String @unique
  email String @unique
  password String 
  avatars Avatar[]
  avatarVideos AvatarVideo[]

}

model Avatar{
  id String @id @default(uuid())
  name String
  userId String
  user User  @relation(fields: [userId] , references: [id])
  avatarImages AvatarImage[]
  avatarVideoRefs AvatarVideoRef[]

}

model AvatarImage{
  id String @id @default(uuid())
  type  AvatarImageType
  url String
  avatarId String
  avatar Avatar @relation(fields: [avatarId] , references: [id])
}

model AvatarVideo{
  id String @id @default(uuid())
  prompt String
  startFrame String?
  endFramse String?
  duration Int
  height Int
  status AvatarVideoStatus
  userId String
  user User @relation(fields: [userId] , references: [id])
  avatarVideoRefs AvatarVideoRef[]

}

model AvatarVideoRef{
  id String @id @default(uuid())
  avatarVideoId String
  avatarId String
  avatar Avatar @relation(fields: [avatarId] , references: [id])
  avatarVideo AvatarVideo @relation(fields: [avatarVideoId] , references: [id])

}

enum AvatarImageType {
  User 
  Model
}

enum AvatarVideoStatus{
  Pending
  Done
  Error
}